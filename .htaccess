# Crystal Water — Apache config for SherlockHost (cPanel). Static site, no CMS.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS + non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://crystalwater.kiev.ua%{REQUEST_URI} [L,R=301]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/(ua/)?index\.html[\s?] [NC]
RewriteRule ^(ua/)?index\.html$ /$1 [L,R=301]
</IfModule>

# Merged / removed duplicate URLs (blog URL structure unchanged: decision "Variant A")
Redirect 301 /prices.html /uslugi-i-tseny.html
Redirect 301 /tech.html /tekhnologii-ochistki.html
Redirect 301 /articles_updated.html /articles.html
Redirect 301 /voda-h2o-stati/ /articles.html
Redirect 301 /ua/prices.html /ua/tsiny.html
Redirect 301 /ua/tech.html /ua/tekhnologii-ochystky.html

# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

# Caching: fingerprinted CSS bundles and images are immutable-ish, HTML revalidates
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/xml "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(css|webp)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
